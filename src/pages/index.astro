<section class="quote-section">
  <div class="quote-container">
    <img src="/quote-icon.svg" class="quote-icon icon-left" alt="quote" />
    
    <p class="quote-text" id="typewriter-quote">
      Podemos sentarnos con políticos, empresarios y líderes sociales para generar transformaciones profundas, pero no nos limitamos a eso. Nuestra verdadera fortaleza radica en nuestra capacidad para navegar en los entornos más complejos, donde la incertidumbre es la norma y las soluciones convencionales no funcionan.
    </p>

    <img src="/quote-icon.svg" class="quote-icon icon-right" alt="quote" />
  </div>
</section>

<script>
  function setupTypewriter() {
    const quoteElement = document.getElementById('typewriter-quote');
    if (!quoteElement) return;

    const text = quoteElement.innerText;
    const words = text.split(' ');
    
    // Limpiamos el texto y lo envolvemos en spans
    quoteElement.innerHTML = words
      .map(word => `<span class="word">${word}</span>`)
      .join('');

    const wordSpans = quoteElement.querySelectorAll('.word');

    // Observer para disparar la animación al entrar en pantalla
    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          // Animación palabra por palabra
          wordSpans.forEach((span, index) => {
            setTimeout(() => {
              span.classList.add('visible');
            }, index * 150); // Velocidad: 150ms entre palabras
          });
          observer.unobserve(entry.target); // Solo animar una vez
        }
      });
    }, { threshold: 0.5 });

    observer.observe(quoteElement);
  }

  // Ejecutar al cargar la página
  setupTypewriter();
</script>

